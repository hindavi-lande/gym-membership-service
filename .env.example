PORT=3000
NODE_ENV=development

# SQLite file used for local dev. Point DB_STORAGE elsewhere or swap the
# dialect in src/config/database.js to use Postgres/MySQL in other envs.
DB_STORAGE=./data/dev.sqlite

# Base URL of gym-payments-service, used for renewal charges and payment history.
PAYMENTS_SERVICE_URL=http://localhost:3001

# How long to wait for the payments service before treating it as unreachable.
PAYMENTS_SERVICE_TIMEOUT_MS=5000
